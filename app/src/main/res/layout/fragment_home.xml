<?xml version="1.0" encoding="utf-8"?>
<!-- Bento (dark) home: header, board size row, "vs Robot" hero with difficulty, "vs Friend" tile, tool tiles. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_fragmentssettings"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_medium"
                    android:text="@string/home_greeting"
                    android:textColor="@color/db_text_2"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jakarta_extrabold"
                    android:letterSpacing="-0.03"
                    android:text="@string/home_title"
                    android:textColor="@color/db_text"
                    android:textSize="30sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_music"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/db_tile"
                android:contentDescription="@string/sound"
                android:padding="12dp"
                android:src="@drawable/ic_sound_off"
                android:tint="@color/db_text" />

            <ImageView
                android:id="@+id/btn_profile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/db_tile"
                android:contentDescription="@string/profile"
                android:padding="4dp"
                android:src="@drawable/profile_b" />
        </LinearLayout>

        <!-- Board size -->
        <FrameLayout
            android:id="@+id/ll_choose_grid_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:id="@+id/ll_grid_size"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/db_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/db_grid_icon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jakarta_semibold"
                    android:text="@string/board_size"
                    android:textColor="@color/db_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_selected_grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_bold"
                    android:text="Row 4 : Column 4"
                    android:textColor="@color/db_text_2"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_down_arrow"
                    android:tint="@color/db_text_2" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/ll_choose_game_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Hero: vs Robot -->
            <LinearLayout
                android:id="@+id/ll_me_vs_robot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/db_hero"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_player_1_name_vs_robot"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/me" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/jakarta_extrabold"
                        android:text="vs"
                        android:textColor="#CCFFFFFF"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/img_player_2_name_vs_robot"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/robot1" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/db_play_circle"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/jakarta_bold"
                    android:text="@string/play_vs_robot"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_player_1_name_vs_robot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_medium"
                        android:text="@string/me"
                        android:textColor="#D9FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_medium"
                        android:text=" · "
                        android:textColor="#D9FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_player_2_name_vs_robot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_medium"
                        android:text="@string/robot"
                        android:textColor="#D9FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/easy_mode"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/background_difuculty"
                        android:fontFamily="@font/jakarta_bold"
                        android:gravity="center"
                        android:text="@string/easy"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/medium_mode"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/background_difuculty"
                        android:fontFamily="@font/jakarta_bold"
                        android:gravity="center"
                        android:text="@string/medium"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/hard_mode"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/background_difuculty"
                        android:fontFamily="@font/jakarta_bold"
                        android:gravity="center"
                        android:text="@string/hard"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- vs Friend -->
            <LinearLayout
                android:id="@+id/ll_me_vs_friend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/db_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/img_player_1_name_vs_friend"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/me" />

                <ImageView
                    android:id="@+id/img_player_2_name_vs_friend"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="-10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/friend" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_bold"
                        android:text="@string/play_with_friend"
                        android:textColor="@color/db_text"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_player_1_name_vs_friend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta_medium"
                            android:text="@string/me"
                            android:textColor="@color/db_text_2"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta_medium"
                            android:text=" · "
                            android:textColor="@color/db_text_2"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_player_2_name_vs_friend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta_medium"
                            android:text="@string/friend"
                            android:textColor="@color/db_text_2"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Online mode is not offered (kept for the bindings). -->
            <LinearLayout
                android:id="@+id/ll_me_vs_online"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/img_player_1_name_vs_online_friend"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tv_player_1_name_vs_online_friend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/img_player_2_name_vs_online_friend"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tv_player_2_name_vs_online_friend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_history"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:background="@drawable/db_card"
                android:contentDescription="@string/history"
                android:padding="22dp"
                android:src="@drawable/ic_history"
                android:tint="#7FE0B8" />

            <ImageView
                android:id="@+id/btn_setting"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/db_card"
                android:contentDescription="@string/settings"
                android:padding="22dp"
                android:src="@drawable/ic_settings"
                android:tint="#FFB48A" />

            <ImageView
                android:id="@+id/btn_how_to"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/db_card"
                android:contentDescription="@string/how_to_play"
                android:padding="22dp"
                android:src="@drawable/db_help"
                android:tint="#8CC4F5" />

            <ImageView
                android:id="@+id/btn_share"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/db_card"
                android:contentDescription="@string/share"
                android:padding="22dp"
                android:src="@drawable/ic_share"
                android:tint="#C7B6FF" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
